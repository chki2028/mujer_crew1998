const BGradeImage = ({ src, alt }) => {
  const [hasError, setHasError] = useState(false);

  if (hasError) {
    return (
      <div className="w-full h-full flex flex-col items-center justify-center bg-black border-4 border-red-600 border-dashed p-4 text-center">
        <Skull className="text-red-600 mb-2 animate-bounce" size={40} />
        <span className="text-yellow-400 font-bold text-lg leading-tight mb-2">
          [시스템 에러]<br/>여기에 '{alt}' 사진이 떠야 함!
        </span>
        <span className="text-gray-400 text-sm font-sans">
          (현재 프리뷰 환경이라 카톡 사진을 못 불러옵니다. 실제 깃허브 서버에 사진을 올리면 정상 작동합니다!)
        </span>
      </div>
    );
  }

  return (
    <img 
      src={src} 
      alt={alt} 
      className="w-full h-full object-cover"
      onError={() => setHasError(true)}
    />
  );
};

